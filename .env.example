DATABASE_URL=postgres://filemorph:filemorph_local@127.0.0.1:55432/filemorph
REDIS_URL=redis://127.0.0.1:56379
S3_ENDPOINT=http://127.0.0.1:59000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=filemorph
S3_SECRET_ACCESS_KEY=filemorph_local_storage
S3_BUCKET=filemorph
S3_FORCE_PATH_STYLE=true
APP_URL=http://127.0.0.1:3000
# Enable only on a verified public HTTPS domain after launch acceptance.
SEO_INDEXABLE=false
# Replace this with at least 32 random characters before using outside local development.
SESSION_SECRET=local-development-only-change-this-secret-123456789
MAX_UPLOAD_BYTES=1073741824
WORKER_CONCURRENCY=1
FFMPEG_THREADS=2
JOB_TIMEOUT_MS=3600000
FILE_TTL_HOURS=24
# Better Auth: setup:local generates the secret if blank. Keep it server-side.
BETTER_AUTH_URL=http://127.0.0.1:3000
BETTER_AUTH_SECRET=
# local writes private test emails to .data/auth-mail; forbidden in production.
# Set to resend after configuring a verified sending domain.
AUTH_EMAIL_MODE=local
RESEND_API_KEY=
AUTH_EMAIL_FROM=
# Google Cloud: OAuth client type Web application.
# Redirect URI: http://127.0.0.1:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional worker Python override; default is the project's .data/venv interpreter.
# PYTHON_PATH=/absolute/path/to/venv/bin/python

# Server-side only; do not put keys in NEXT_PUBLIC_* or this example file.
TRANSCRIPTION_PROVIDER=dashscope
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
TRANSCRIPTION_MODEL=fun-asr
# Translation tools share the server-side DASHSCOPE key and region.
TRANSLATION_MODEL=qwen-mt-plus
TRANSLATION_OCR_MODEL=qwen3.5-ocr
TRANSLATION_IMAGE_MODEL=qwen-image-2.0-pro-2026-06-22
AI_READING_MODEL=qwen3.7-plus
# Per-model shared request/token pacing; Retry-After is respected automatically.
TRANSLATION_RPM=45
TRANSLATION_TPM=18000
AI_READING_RPM=30
AI_READING_TPM=500000
IMAGE_REPAIR_RPM=5
# FFmpeg requires libass; macOS: brew install ffmpeg-full libraqm cairo
# FFMPEG_PATH=/opt/homebrew/opt/ffmpeg-full/bin/ffmpeg
# FFPROBE_PATH=/opt/homebrew/opt/ffmpeg-full/bin/ffprobe
# SOFFICE_PATH=/absolute/path/to/soffice
# Optional alternative: set provider=openai and model=gpt-4o-transcribe-diarize.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional OpenAI-compatible gateway. Keys stay server-side; saved steps keep their original route.
AI_GATEWAY_BASE_URL=https://ai.ctaigw.cn/v1
AI_GATEWAY_API_KEY=
# Set to openai and TRANSLATION_MODEL=qwen3.6-plus after local acceptance.
TRANSLATION_TEXT_PROVIDER=dashscope
# Reading can be evaluated independently; OCR stays native.
AI_READING_PROVIDER=dashscope
# Separate image gateway account. Set provider=openai and TRANSLATION_IMAGE_MODEL=gpt-image-2.
# The verified gateway uses chat/completions and returns an inline PNG.
TRANSLATION_IMAGE_PROVIDER=dashscope
AI_IMAGE_GATEWAY_BASE_URL=https://pdhlzy.art/v1
AI_IMAGE_GATEWAY_API_KEY=

# Production defaults to samples/existing results while billing is in shadow mode.
# Enable only for a controlled, budgeted cost calibration; this does not enable sales.
BILLING_SHADOW_EXECUTION=false

# Waffo Pancake test checkout. Keep the private key server-side; never expose it as NEXT_PUBLIC_*.
WAFFO_MERCHANT_ID=
WAFFO_STORE_ID=
WAFFO_PRIVATE_KEY=
WAFFO_ENVIRONMENT=test
WAFFO_PRODUCT_BASIC_ID=
WAFFO_PRODUCT_PRO_ID=
WAFFO_PRODUCT_PREMIUM_ID=
# Local-only test checkout override. Keep false in production; production also requires sales_enabled.
WAFFO_TEST_CHECKOUT_ENABLED=false

# Independent single-account management console (/admin).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
# Optional; defaults to BETTER_AUTH_SECRET (at least 32 characters).
ADMIN_SESSION_SECRET=
